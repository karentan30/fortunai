# 善缘支付和邀请系统 - 测试配置示例
# 复制此文件为 .env，填入实际值后，测试脚本会自动加载

# ═════════════════════════════════════════════════
# API 配置
# ═════════════════════════════════════════════════

# API 服务器基础地址
API_BASE_URL=http://localhost:3000
# API_BASE_URL=https://shenyuan.mylumee.cn

# ═════════════════════════════════════════════════
# 认证和授权
# ═════════════════════════════════════════════════

# 管理员令牌（用于创建 affiliate、查询统计等）
ADMIN_TOKEN=test-admin-token-here

# ═════════════════════════════════════════════════
# Stripe 配置（国际支付）
# ═════════════════════════════════════════════════

# Stripe 测试密钥
STRIPE_TEST_SECRET_KEY=sk_test_...

# Stripe Webhook 端点密钥（用于签名验证）
STRIPE_WEBHOOK_SECRET=whsec_test_...

# Stripe 支付方式（逗号分隔）
# 可选: card, ideal, bancontact, giropay, eps, p24, sepa_debit, klarna, afterpay_clearpay
STRIPE_PAYMENT_METHODS=card

# ═════════════════════════════════════════════════
# 微信支付配置（中国市场）
# ═════════════════════════════════════════════════

# 微信支付 API 密钥
WX_PAY_SECRET_KEY=your_wx_secret

# 微信公众平台 App ID
WX_APPID=wx1234567890abcdef

# 微信商户号
WX_MERCHANT_ID=1234567890

# ═════════════════════════════════════════════════
# 支付宝配置（中国市场）
# ═════════════════════════════════════════════════

# 支付宝 API 密钥（MD5 或 RSA）
ALIPAY_SECRET_KEY=your_alipay_secret

# 支付宝应用 ID
ALIPAY_APP_ID=2021000000000000

# 支付宝商户 PID
ALIPAY_PID=2088000000000000

# ═════════════════════════════════════════════════
# 测试数据配置
# ═════════════════════════════════════════════════

# 批量生成邀请码数量
BATCH_AFFILIATE_COUNT=100

# 邀请码前缀（用于批量生成）
# 示例: SUMMER2024, WAVE, PROMO
AFFILIATE_PREFIX=TEST

# 邀请码基础 URL（生成分享链接时使用）
BASE_URL=https://shenyuan.mylumee.cn

# ═════════════════════════════════════════════════
# 返佣配置
# ═════════════════════════════════════════════════

# 默认返佣比例（0.0 - 1.0）
# 0.10 = 10%, 0.15 = 15%, 0.20 = 20%
DEFAULT_COMMISSION_RATE=0.15

# 最高返佣比例（上限保护）
MAX_COMMISSION_RATE=0.30

# 最低返佣比例（下限保护）
MIN_COMMISSION_RATE=0.05

# ═════════════════════════════════════════════════
# 测试邮箱配置
# ═════════════════════════════════════════════════

# 测试邮箱域名
TEST_EMAIL_DOMAIN=@shenyuan.local

# 接收测试邮件的邮箱（可选）
# 用于验证邮件发送功能
TEST_RECEIPT_EMAIL=test@example.com

# ═════════════════════════════════════════════════
# 日志和调试
# ═════════════════════════════════════════════════

# 日志级别: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# 启用详细 curl 输出（调试用）
# 值: 0 (关闭) 或 1 (开启)
VERBOSE_CURL=0

# 保存测试结果到文件
SAVE_TEST_RESULTS=1
TEST_RESULTS_FILE=/tmp/payment_tests_$(date +%Y%m%d_%H%M%S).json

# ═════════════════════════════════════════════════
# 高级选项
# ═════════════════════════════════════════════════

# 网络超时（秒）
CURL_TIMEOUT=10

# 最大重试次数（用于轮询支付状态）
MAX_RETRIES=5

# 重试间隔（秒）
RETRY_INTERVAL=2

# 允许自签名 HTTPS 证书（不建议用于生产）
INSECURE_SSL=0

# ═════════════════════════════════════════════════
# 国家和地区配置
# ═════════════════════════════════════════════════

# 测试国家代码（影响货币和支付方式选择）
# US: 美国 (USD)
# CN: 中国 (CNY)
# KR: 韩国 (KRW)
TEST_COUNTRIES=US,CN,KR

# ═════════════════════════════════════════════════
# 特殊场景测试
# ═════════════════════════════════════════════════

# 测试小额支付（分币级）
TEST_SMALL_AMOUNT_USD=0.50

# 测试大额支付
TEST_LARGE_AMOUNT_USD=999.99

# 测试订阅续费
TEST_SUBSCRIPTION_RENEWAL=1

# 测试过期处理
TEST_PAYMENT_EXPIRY=1
