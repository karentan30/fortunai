PORT=3020
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── 中国支付（微信 NATIVE 扫码 + 支付宝当面付）──
# 善缘自己的域名(notify_url 用它，红线：不要用 Lumee 的域名/NOTIFY_URL)
SHENYUAN_BASE_URL=https://shenyuan.mylumee.cn

# 微信支付 APIv2（商户平台申请）
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
# 可选：覆盖回调地址（默认 = SHENYUAN_BASE_URL + /pay/wechat/notify）
# WECHAT_NOTIFY_URL=

# 支付宝当面付（开放平台）
ALIPAY_APP_ID=
# 二选一：直接给 PEM 内容 或 给文件路径
ALIPAY_PRIVATE_KEY=
# ALIPAY_PRIVATE_KEY_PATH=/etc/shenyuan/alipay_private_key.pem
ALIPAY_PUBLIC_KEY=
# ALIPAY_PUBLIC_KEY_PATH=/etc/shenyuan/alipay_public_key.pem
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# ALIPAY_NOTIFY_URL=
