# Configuration template only. No credentials; all services start closed.
# Copy outside the web root and fill through the deployment secret manager.
FRIENDS_ENABLED=false
FRIENDS_RELEASE_MODE=closed_beta
FRIENDS_ALLOWED_USER_IDS=
FRIENDS_DB_FILE=
FRIENDS_DATA_KEY=
FRIENDS_SIGNING_KEY=
FRIENDS_ADMIN_TOKEN=

# Verify exact registered operator identity and actual operating arrangements.
FRIENDS_OPERATOR_NAME=
FRIENDS_SUPPORT_EMAIL=
FRIENDS_STORAGE_REGION=
FRIENDS_RETENTION_POLICY=
FRIENDS_PUBLIC_APPROVED=false
FRIENDS_IDENTITY_REVIEWED=false
FRIENDS_LEGAL_REVIEWED=false
FRIENDS_BACKUP_VERIFIED=false

# Keep payments closed until real merchant, SKU, status and delivery checks pass.
FRIENDS_REPORTS_ENABLED=false
FRIENDS_REPORT_DELIVERY_VERIFIED=false
FRIENDS_BILLING_ENABLED=false
FRIENDS_BILLING_SALES_PAUSED=false
FRIENDS_BILLING_MERCHANT_VERIFIED=false
FRIENDS_BILLING_FRESH_PULL_VERIFIED=false
FRIENDS_BILLING_MERCHANT_NAME=
FRIENDS_BILLING_PRODUCTS={}
# Existing shared Hub settings are supplied securely by the deployment.
# Never repoint the old Hub callback without a migration plan.
