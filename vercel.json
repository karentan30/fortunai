{
  "version": 2,
  "name": "shenyuan",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": "cd server && npm install --include=dev && cd ..",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
